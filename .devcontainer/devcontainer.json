{
  "name": "Parichay Dev Container",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installGradle": true
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "typescript.tsdk": "node_modules/typescript/lib",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "vitest.explorer"
      ]
    }
  },
  "postCreateCommand": "npm install && npm run tokens:build",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Parichay Dev Server",
      "onAutoForward": "openPreview"
    }
  },
  "comment": "Note: iOS native builds require macOS with Xcode and cannot be compiled inside a Linux container."
}
